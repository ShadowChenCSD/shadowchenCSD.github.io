---
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { scanAlbums } from "../utils/album-scanner";

if (!siteConfig.featurePages.albums) {
	return Astro.redirect("/404/");
}

const albumsData = await scanAlbums();

const title = i18n(I18nKey.albums);
const subtitle = i18n(I18nKey.albumsSubtitle);
const albumsCount = i18n(I18nKey.albumsCount);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-4 py-4 md:px-6 md:py-5 relative w-full overflow-hidden">
			<div class="relative w-full mb-5 px-2 md:px-0">
				<div
					class="rounded-xl bg-gradient-to-r from-[var(--primary)] to-[var(--primary-dark,var(--primary))] p-5 sm:p-6"
				>
					<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
						<div class="min-w-0">
							<h1
								class="text-2xl sm:text-3xl font-bold text-white/90 mb-1 drop-shadow-sm truncate"
							>
								{title}
							</h1>
							<p
								class="text-sm md:text-base lg:text-lg text-white/90 truncate"
							>
								{subtitle}
							</p>
						</div>
						<div class="shrink-0 text-center mt-2 md:mt-0">
							<span
								class="text-lg md:text-xl lg:text-2xl font-bold text-white drop-shadow-sm"
							>
								{albumsData.length}
							</span>
							<span
								class="text-xs md:text-sm lg:text-base text-white/75"
							>
								{albumsCount}
							</span>
						</div>
					</div>
				</div>
			</div>

			<div class="px-2 md:px-0 pt-0 pb-6">
				<div id="albums-grid" class="grid gap-6 items-start">
					{
						albumsData.map((album) => (
							<article
								class="album-list-card group overflow-hidden rounded-xl border border-black/8 bg-[var(--card-bg)] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-white/10"
							>
								<a href={`/albums/${album.id}/`} class="block h-full">
									<div class="aspect-4/3 overflow-hidden bg-black/5 dark:bg-white/5">
										{
											album.cover ? (
												<img
													src={album.cover}
													alt={album.title}
													class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
													loading="lazy"
													decoding="async"
												/>
											) : (
												<div class="flex h-full w-full items-center justify-center">
													<iconify-icon
														icon="material-symbols:photo-library"
														width="48"
														height="48"
														class="text-black/20 dark:text-white/20"
													/>
												</div>
											)
										}
									</div>

									<div class="p-4 sm:p-5">
										<h3
											class="mb-2 text-lg font-bold text-black/90 transition-colors group-hover:text-[var(--primary)] dark:text-white/90"
										>
											{album.title}
										</h3>

										{
											album.description && (
												<p
													class="line-clamp-2 mb-3 text-sm leading-6 text-black/60 dark:text-white/60"
												>
													{album.description}
												</p>
											)
										}

										<div
											class="flex items-center justify-between gap-3 text-xs text-black/45 dark:text-white/45"
										>
											<div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1">
												<span>
													{album.photos.length}{" "}
													{album.photos.length > 1
														? i18n(I18nKey.albumsPhotosCount)
														: i18n(I18nKey.albumsPhotoCount)}
												</span>
												{
													album.location && (
														<span class="inline-flex min-w-0 items-center gap-1 truncate">
															<svg
																class="h-3 w-3 shrink-0"
																fill="currentColor"
																viewBox="0 0 20 20"
															>
																<path
																	fill-rule="evenodd"
																	d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
																	clip-rule="evenodd"
																></path>
															</svg>
															<span class="truncate">{album.location}</span>
														</span>
													)
												}
											</div>
											{
												album.date && (
													<time class="shrink-0">
														{new Date(album.date).toLocaleDateString("zh-CN")}
													</time>
												)
											}
										</div>

										{
											album.tags && album.tags.length > 0 && (
												<div class="mt-3 flex flex-wrap gap-2">
													{album.tags.slice(0, 5).map((tag) => (
														<span
															class="rounded-lg bg-black/5 px-2 py-1 text-xs text-black/65 dark:bg-white/8 dark:text-white/65"
														>
															{tag}
														</span>
													))}
													{
														album.tags.length > 5 && (
															<span
																class="rounded-lg bg-black/5 px-2 py-1 text-xs text-black/65 dark:bg-white/8 dark:text-white/65"
															>
																+{album.tags.length - 5}
															</span>
														)
													}
												</div>
											)
										}
									</div>
								</a>
							</article>
						))
					}
				</div>

				{
					albumsData.length === 0 && (
						<div class="text-center py-16">
							<iconify-icon
								icon="material-symbols:photo-library"
								width="64"
								height="64"
								class="text-black/15 dark:text-white/15 mb-4"
							/>
							<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2">
								{i18n(I18nKey.albumsEmpty)}
							</h3>
							<p class="text-black/60 dark:text-white/60">
								{i18n(I18nKey.albumsEmptyDesc)}
							</p>
						</div>
					)
				}
			</div>
		</div>
	</div>
</MainGridLayout>

<style is:global>
	#albums-grid {
		grid-template-columns: 1fr;
	}

	.album-list-card {
		animation: fadeInUp 0.35s ease-out;
	}

	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (min-width: 640px) {
		#albums-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	#main-grid[data-layout-mode="grid"] #albums-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	@media (max-width: 639px) {
		#main-grid[data-layout-mode="grid"] #albums-grid {
			grid-template-columns: 1fr;
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
