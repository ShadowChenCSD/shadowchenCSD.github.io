---
import { FilterTabs } from "@components/atoms/filter-tabs";
import { MomentCard } from "@components/features/diary";
import MainGridLayout from "@layouts/MainGridLayout.astro";

import { siteConfig } from "../config";
import { PAGE_SIZE } from "../constants/constants";
import { getAllTags, getDiaryList } from "../data/diary";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";

if (!siteConfig.featurePages.diary) {
	return Astro.redirect("/404/");
}

const moments = getDiaryList();
const allTags = getAllTags();

const filterTabs = [
	{
		value: "all",
		label: i18n(I18nKey.albumsFilterAll),
		icon: "material-symbols:apps",
		count: moments.length,
	},
	...allTags.map((tag) => ({
		value: tag,
		label: tag,
		count: moments.filter((m) => m.tags && m.tags.includes(tag)).length,
	})),
];

const minutesAgo = i18n(I18nKey.diaryMinutesAgo);
const hoursAgo = i18n(I18nKey.diaryHoursAgo);
const daysAgo = i18n(I18nKey.diaryDaysAgo);

const title = i18n(I18nKey.diary);
const subtitle = i18n(I18nKey.diarySubtitle);
const diaryCount = i18n(I18nKey.diaryCount);
---

<MainGridLayout title={title} description={subtitle}>
	<script>
		import("../scripts/right-sidebar-layout.js");
		import { loadIconify } from "../utils/icon-loader";

		loadIconify().catch((error) => {
			console.error("Failed to load Iconify:", error);
		});
	</script>

	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-4 py-4 md:px-6 md:py-5 relative w-full overflow-hidden">
			<!-- Gradient Banner -->
			<div class="relative w-full mb-5 px-2 md:px-0">
				<div
					class="rounded-xl bg-gradient-to-r from-[var(--primary)] to-[var(--primary-dark,var(--primary))] p-5 sm:p-6"
				>
					<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
						<div class="min-w-0">
							<h1
								class="text-2xl sm:text-3xl font-bold text-white/90 mb-1 drop-shadow-sm truncate"
							>
								{title}
							</h1>
							<p
								class="text-sm md:text-base lg:text-lg text-white/90 truncate"
							>
								{subtitle}
							</p>
						</div>
						<div class="shrink-0 text-center mt-2 md:mt-0">
							<span
								class="text-lg md:text-xl lg:text-2xl font-bold text-white drop-shadow-sm"
							>
								{moments.length}
							</span>
							<span
								class="text-xs md:text-sm lg:text-base text-white/75"
							>
								{diaryCount}
							</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Content -->
			<div class="px-2 md:px-0 pt-0 pb-6">
				{
					moments.length > 0 && allTags.length > 0 && (
						<div class="mb-8">
							<FilterTabs tabs={filterTabs} dataAttr="tags" />
						</div>
					)
				}

				<div id="diary-list" class="space-y-4" data-page-size={PAGE_SIZE}>
					{
						moments.map((moment, index) => (
							<div
								class="diary-entry"
								data-tags={moment.tags?.join(",") || ""}
								data-index={index}
							>
								<MomentCard
									moment={moment}
									index={index}
									minutesAgo={minutesAgo}
									hoursAgo={hoursAgo}
									daysAgo={daysAgo}
								/>
							</div>
						))
					}
				</div>

				<div
					id="diary-pagination"
					class:list={[
						"mx-auto mt-8 flex flex-row gap-3 justify-center",
						{ hidden: moments.length <= PAGE_SIZE },
					]}
				></div>

				<div id="no-results" class="hidden text-center py-16">
					<iconify-icon
						icon="material-symbols:edit-note"
						width="64"
						height="64"
						class="text-black/15 dark:text-white/15 mb-4"
					></iconify-icon>
					<p class="text-black/40 dark:text-white/40 text-lg">
						{i18n(I18nKey.diaryNoResults)}
					</p>
				</div>

				{
					moments.length === 0 && (
						<div class="text-center py-16">
							<iconify-icon
								icon="material-symbols:edit-note"
								width="64"
								height="64"
								class="text-black/15 dark:text-white/15 mb-4"
							/>
							<h3 class="text-lg font-medium text-black/90 dark:text-white/90 mb-2">
								{i18n(I18nKey.diaryNoResults)}
							</h3>
						</div>
					)
				}
			</div>
		</div>
	</div>

	<script is:inline>
		(() => {
			const HIDDEN = -1;
			const ADJ_DIST = 2;
			const VISIBLE = ADJ_DIST * 2 + 1;

			function getPages(currentPage, lastPage) {
				let count = 1;
				let l = currentPage;
				let r = currentPage;

				while (0 < l - 1 && r + 1 <= lastPage && count + 2 <= VISIBLE) {
					count += 2;
					l--;
					r++;
				}
				while (0 < l - 1 && count < VISIBLE) {
					count++;
					l--;
				}
				while (r + 1 <= lastPage && count < VISIBLE) {
					count++;
					r++;
				}

				const pages = [];
				if (l > 1) pages.push(1);
				if (l === 3) pages.push(2);
				if (l > 3) pages.push(HIDDEN);
				for (let i = l; i <= r; i++) pages.push(i);
				if (r < lastPage - 2) pages.push(HIDDEN);
				if (r === lastPage - 2) pages.push(lastPage - 1);
				if (r < lastPage) pages.push(lastPage);
				return pages;
			}

			function initDiaryPagination() {
				const diaryList = document.getElementById("diary-list");
				const pagination = document.getElementById("diary-pagination");
				const noResults = document.getElementById("no-results");
				const filterTabs = document.querySelectorAll(".filter-tabs-item");

				if (!diaryList || !pagination) {
					return;
				}

				const pageSize = Number(diaryList.dataset.pageSize || 12);
				const entries = Array.from(diaryList.querySelectorAll(".diary-entry"));
				let activeFilter = "all";
				let currentPage = 1;

				function getFilteredEntries() {
					return entries.filter((entry) => {
						const tags = entry.getAttribute("data-tags") || "";
						return (
							activeFilter === "all" ||
							tags.split(",").filter(Boolean).includes(activeFilter)
						);
					});
				}

				function createIconButton(icon, disabled, onClick, ariaLabel) {
					const button = document.createElement("button");
					button.type = "button";
					button.setAttribute("aria-label", ariaLabel);
					button.className =
						"btn-card overflow-hidden rounded-lg text-[var(--primary)] w-11 h-11";
					if (disabled) {
						button.classList.add("disabled");
						button.disabled = true;
					} else {
						button.addEventListener("click", onClick);
					}

					const iconEl = document.createElement("iconify-icon");
					iconEl.setAttribute("icon", icon);
					iconEl.setAttribute("width", "28");
					iconEl.setAttribute("height", "28");
					button.appendChild(iconEl);

					return button;
				}

				function createPageButton(pageNumber, isActive) {
					if (pageNumber === HIDDEN) {
						const more = document.createElement("iconify-icon");
						more.setAttribute("icon", "material-symbols:more-horiz");
						more.setAttribute("width", "24");
						more.setAttribute("height", "24");
						more.className = "mx-1 self-center text-neutral-700 dark:text-neutral-300";
						return more;
					}

					if (isActive) {
						const current = document.createElement("div");
						current.className =
							"h-11 w-11 rounded-lg bg-[var(--primary)] flex items-center justify-center font-bold text-white dark:text-black/70";
						current.textContent = String(pageNumber);
						return current;
					}

					const button = document.createElement("button");
					button.type = "button";
					button.className =
						"btn-card w-11 h-11 rounded-lg overflow-hidden active:scale-[0.85]";
					button.textContent = String(pageNumber);
					button.setAttribute("aria-label", `Page ${pageNumber}`);
					button.addEventListener("click", () => {
						currentPage = pageNumber;
						render();
					});
					return button;
				}

				function renderPagination(totalPages) {
					pagination.innerHTML = "";
					pagination.classList.toggle("hidden", totalPages <= 1);

					if (totalPages <= 1) {
						return;
					}

					const prevButton = createIconButton(
						"material-symbols:chevron-left-rounded",
						currentPage === 1,
						() => {
							currentPage--;
							render();
						},
						"上一页",
					);

					const nextButton = createIconButton(
						"material-symbols:chevron-right-rounded",
						currentPage === totalPages,
						() => {
							currentPage++;
							render();
						},
						"下一页",
					);

					const pagesWrapper = document.createElement("div");
					pagesWrapper.className =
						"bg-[var(--card-bg)] flex flex-row rounded-lg items-center text-neutral-700 dark:text-neutral-300 font-bold";

					getPages(currentPage, totalPages).forEach((pageNumber) => {
						pagesWrapper.appendChild(
							createPageButton(pageNumber, pageNumber === currentPage),
						);
					});

					pagination.appendChild(prevButton);
					pagination.appendChild(pagesWrapper);
					pagination.appendChild(nextButton);
				}

				function render() {
					const filteredEntries = getFilteredEntries();
					const totalPages = Math.max(
						1,
						Math.ceil(filteredEntries.length / pageSize),
					);

					if (currentPage > totalPages) {
						currentPage = totalPages;
					}

					const start = (currentPage - 1) * pageSize;
					const end = start + pageSize;

					entries.forEach((entry) => {
						entry.classList.add("hidden");
					});

					filteredEntries.slice(start, end).forEach((entry) => {
						entry.classList.remove("hidden");
					});

					if (noResults) {
						noResults.classList.toggle("hidden", filteredEntries.length > 0);
					}

					renderPagination(totalPages);
				}

				filterTabs.forEach((tab) => {
					if (tab.dataset.diaryPaginationBound === "true") {
						return;
					}

					tab.dataset.diaryPaginationBound = "true";
					tab.addEventListener("click", () => {
						filterTabs.forEach((item) => item.classList.remove("active"));
						tab.classList.add("active");
						activeFilter = tab.dataset.filterValue || "all";
						currentPage = 1;
						render();
					});
				});

				render();
			}

			if (document.readyState === "loading") {
				document.addEventListener("DOMContentLoaded", initDiaryPagination);
			} else {
				initDiaryPagination();
			}

			document.addEventListener("astro:page-load", initDiaryPagination);
		})();
	</script>
</MainGridLayout>
