---
import AnimeCard from "./AnimeCard.astro";
import { Icon } from "astro-icon/components";

interface StatusInfo {
	text: string;
	class: string;
	icon: string;
}

interface AnimeItem {
	title: string;
	cover: string;
	link: string;
	status: string;
	rating: number;
	progress: number;
	totalEpisodes: number;
	description: string;
	actor: string;
	year: string;
	studio: string;
	genre: string[];
}

interface Props {
	animeList: AnimeItem[];
	pageSize: number;
	statusMap: Record<string, StatusInfo>;
	actorLabel: string;
	yearLabel: string;
	studioLabel: string;
}

const { animeList, pageSize, statusMap, actorLabel, yearLabel, studioLabel } =
	Astro.props;
---

<div
	id="anime-list-container"
	data-page-size={pageSize}
	class="anime-grid-container grid gap-4 md:gap-6 opacity-0 transition-opacity duration-300"
>
	{
		animeList.map((anime, index) => {
			const statusInfo = statusMap[anime.status] || {
				text: anime.status,
				class: "btn-regular",
				icon: "?",
			};
			return (
				<AnimeCard
					anime={anime}
					itemIndex={index}
					statusInfo={statusInfo}
					actorLabel={actorLabel}
					yearLabel={yearLabel}
					studioLabel={studioLabel}
				/>
			);
		})
	}
</div>

<nav
	id="anime-pagination"
	class="anime-pagination is-hidden mt-8"
	aria-label="Anime pagination"
>
	<button
		id="anime-page-prev"
		type="button"
		class="anime-page-btn btn-card overflow-hidden rounded-lg text-[var(--primary)] w-11 h-11"
	>
		<Icon
			name="material-symbols:chevron-left-rounded"
			class="text-[1.75rem]"
		/>
	</button>
	<div
		id="anime-page-numbers"
		class="anime-page-numbers bg-[var(--card-bg)] flex flex-row rounded-lg items-center text-neutral-700 dark:text-neutral-300 font-bold"
	/>
	<button
		id="anime-page-next"
		type="button"
		class="anime-page-btn btn-card overflow-hidden rounded-lg text-[var(--primary)] w-11 h-11"
	>
		<Icon
			name="material-symbols:chevron-right-rounded"
			class="text-[1.75rem]"
		/>
	</button>
</nav>
