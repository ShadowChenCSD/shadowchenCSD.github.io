---
import Image from "@components/atoms/Image/Image.astro";

interface GameItem {
	title: string;
	cover: string;
	link: string;
	status: string;
	rating: number;
	description: string;
	actor: string;
	year: string;
	platform: string;
	genre: string[];
}

interface Props {
	game: GameItem;
	itemIndex?: number;
	statusInfo: {
		text: string;
		class: string;
		icon: string;
	};
	actorLabel: string;
	yearLabel: string;
	platformLabel: string;
}

const {
	game,
	itemIndex = 0,
	statusInfo,
	actorLabel,
	yearLabel,
	platformLabel,
} = Astro.props;
const ratingDisplay = game.rating.toFixed(1);
---

<div
	class="group relative bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-[var(--radius-large)] overflow-hidden hover:shadow-lg"
	data-game-status={game.status}
	data-game-index={itemIndex}
>
	<div class="relative game-cover-container aspect-[4/3] overflow-hidden">
		{
			game.link ? (
				<a
					href={game.link}
					target="_blank"
					rel="noopener noreferrer"
					class="block w-full h-full"
				>
					<Image
						src={game.cover}
						alt={game.title}
						class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
						widths={[200, 400, 600]}
						sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 20vw"
					/>
					<div
						class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
					>
						<div class="absolute inset-0 flex items-center justify-center">
							<div
								class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center"
							>
								<svg
									class="w-6 h-6 text-gray-800 ml-1"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M8 5v14l11-7z"></path>
								</svg>
							</div>
						</div>
					</div>
				</a>
			) : (
				<div class="block w-full h-full cursor-default">
					<Image
						src={game.cover}
						alt={game.title}
						class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
						widths={[200, 400, 600]}
						sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 20vw"
					/>
					<div
						class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
					>
						<div class="absolute inset-0 flex items-center justify-center">
							<div
								class="w-12 h-12 rounded-full bg-red-600/90 flex items-center justify-center"
							>
								<svg
									class="w-6 h-6 text-white"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M6 6h12v12H6z"></path>
								</svg>
							</div>
						</div>
					</div>
				</div>
			)
		}

		<div
			class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
		>
			<span class="mr-1">{statusInfo.icon}</span>
			<span>{statusInfo.text}</span>
		</div>

		<div
			class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1"
		>
			<svg
				class="w-3 h-3 text-yellow-400"
				fill="currentColor"
				viewBox="0 0 20 20"
			>
				<path
					d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
				></path>
			</svg>
			<span>{ratingDisplay}</span>
		</div>
	</div>

	<div class="p-3">
		<h3
			class="text-sm font-bold text-black/90 dark:text-white/90 mb-1 leading-tight"
		>
			{game.title}
		</h3>
		<p
			class="text-black/60 dark:text-white/60 text-xs mb-2 line-clamp-2"
			title={game.description}
		>
			{game.description}
		</p>

		<div class="space-y-1 text-xs">
			<div class="flex justify-between items-start">
				<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
					{actorLabel}
				</span>
				<span
					class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 break-words"
					title={game.actor}
				>
					{game.actor || "-"}
				</span>
			</div>
			<div class="flex justify-between items-center">
				<span class="text-black/50 dark:text-white/50 shrink-0">
					{yearLabel}
				</span>
				<span
					class="text-black/70 dark:text-white/70 truncate ml-2 text-right"
				>
					{game.year}
				</span>
			</div>
			<div class="flex justify-between items-start">
				<span class="text-black/50 dark:text-white/50 shrink-0 mt-0.5">
					{platformLabel}
				</span>
				<span
					class="text-black/70 dark:text-white/70 text-right ml-2 line-clamp-2 break-words"
					title={game.platform}
				>
					{game.platform || "-"}
				</span>
			</div>
			<div class="flex flex-wrap gap-1 mt-2">
				{
					game.genre.map((g) => (
						<span class="px-1.5 py-0.5 bg-[var(--btn-regular-bg)] text-black/70 dark:text-white/70 rounded text-xs">
							{g}
						</span>
					))
				}
			</div>
		</div>
	</div>
</div>
